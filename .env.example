# ===================================================================
# SPN TRUCKING LTD. — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure with production credentials
# ===================================================================

# Server Configuration
PORT=3000
NODE_ENV=production
APP_DOMAIN=https://spntrucking.ca

# Security & Authentication
JWT_SECRET=your-random-32-character-secret-key-here
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=ChangeMeImmediatelyInProduction2026!

# Database Configuration
DB_PATH=./data/spn_trucking.db

# Business Notification Endpoints
NOTIFICATION_EMAIL=stntruckingltd@gmail.com
NOTIFICATION_PHONE=778-302-8803

# SMTP Email Dispatch (Required for real email dispatch)
# For Google Workspace / Gmail, use an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=stntruckingltd@gmail.com
SMTP_PASS=your-16-character-app-password

# Twilio SMS Alerts (Required for real SMS alerts)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+17783028803
